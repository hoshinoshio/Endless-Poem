extends SceneTree
const Opening = preload("res://scripts/onboarding/opening_sequence.gd")
const Tutorial = preload("res://scripts/onboarding/exploration_tutorial.gd")
var failures: Array = []
var accepted_count = 0
var completed_count = 0
var observed_steps: Array = []
func _initialize() -> void: call_deferred("run")
func check(value: bool, message: String) -> void:
	if not value: failures.append(message)
func make_opening():
	var opening = Opening.new()
	root.add_child(opening)
	opening.set_process(false)
	opening.accepted.connect(func(): accepted_count += 1)
	return opening
func run() -> void:
	var opening = make_opening()
	var exact_texts = ["沉睡的神明即将苏醒", "世界在崩坏", "你是最终的幸存者、亦是被寄以希望的无暇之人", "你是否愿意拯救这个世界？"]
	check(opening.presentation_state().texts == exact_texts, "Opening preserves exact requested text including 无暇")
	check(opening.presentation_state().phase == "awakening", "First sentence appears first")
	opening.advance(2.3)
	check(opening.presentation_state().phase == "collapse", "Collapse sentence appears second")
	opening.advance(3.3)
	check(opening.presentation_state().phase == "fracture" and opening.presentation_state().fragment_count == (exact_texts[0].length() + exact_texts[1].length()) * 3, "Actual 3-slice glyph fractures are generated")
	var fragment_start: Vector2 = opening._pieces[0].node.position
	opening.advance(0.5)
	check(opening._pieces[0].node.position != fragment_start, "Fragments move locally instead of only fading full screen")
	opening.advance(2.1)
	check(opening.presentation_state().phase == "survivor", "Survivor line follows fracture")
	opening.advance(3.0)
	check(opening.presentation_state().phase == "survivor" and opening._survivor.modulate.a > 0.99, "Survivor stays fully visible for 3 seconds")
	opening.advance(1.4)
	check(opening.presentation_state().visible_buttons == ["yes", "no"], "Final question exposes yes and no")
	opening.buttons.yes.pressed.emit()
	check(accepted_count == 0, "Question transition blocks click-through")
	opening.advance(0.4)
	opening.buttons.no.pressed.emit()
	check(opening.presentation_state().refusal_count == 0, "Initial no does not count as refusal")
	opening.buttons.refuse_again.pressed.emit()
	check(opening.presentation_state().refusal_count == 0, "Refusal transition blocks double-click")
	for index in range(3):
		opening.advance(0.4)
		opening.buttons.refuse_again.pressed.emit()
		check(opening.presentation_state().refusal_count == index + 1, "Repeat refusal is counted once")
	check(opening.presentation_state().visible_buttons == ["accept_refusal"], "Third refusal leaves only acceptance")
	opening.advance(0.4)
	opening.buttons.refuse_again.pressed.emit()
	check(opening.presentation_state().refusal_count == 3, "Hidden refusal cannot be activated")
	opening.buttons.accept_refusal.pressed.emit()
	opening.buttons.accept_refusal.pressed.emit()
	check(accepted_count == 1, "Forced acceptance emits exactly once")
	var direct = make_opening()
	direct.advance(13.0)
	direct.advance(0.4)
	direct.buttons.yes.pressed.emit()
	direct.buttons.yes.pressed.emit()
	check(accepted_count == 2, "Direct yes emits exactly once")
	var reconsider = make_opening()
	reconsider.advance(13.0)
	reconsider.advance(0.4)
	reconsider.buttons.no.pressed.emit()
	reconsider.advance(0.4)
	reconsider.buttons.accept_refusal.pressed.emit()
	check(accepted_count == 3, "Initial refusal can immediately reconsider")
	for refusal_target in [1, 2]:
		var alternate = make_opening()
		alternate.advance(13.0)
		alternate.advance(0.4)
		alternate.buttons.no.pressed.emit()
		for index in range(refusal_target):
			alternate.advance(0.4)
			alternate.buttons.refuse_again.pressed.emit()
		alternate.advance(0.4)
		alternate.buttons.accept_refusal.pressed.emit()
		check(alternate.presentation_state().accepted, "Reconsideration works after each intermediate refusal count")
	check(accepted_count == 5, "All acceptance routes emit once")
	var tutorial = Tutorial.new()
	tutorial.configure(2)
	root.add_child(tutorial)
	tutorial.step_changed.connect(func(step): observed_steps.append(step))
	tutorial.completed.connect(func(): completed_count += 1)
	check(tutorial.presentation_state().step == 2 and tutorial.presentation_state().hint == "E  调查灯台", "Tutorial restores its saved step")
	tutorial.observe("walked")
	check(tutorial.presentation_state().step == 2, "Out of order event cannot advance restored tutorial")
	tutorial.observe("investigated", {"interaction": "tutorial_lantern"})
	tutorial.observe("fork_completed")
	tutorial.observe("fork_completed")
	check(not tutorial.visible and completed_count == 1 and observed_steps == [3, 4], "Tutorial completes and hides exactly once")
	tutorial.configure(4)
	check(not tutorial.visible and completed_count == 1, "Completed restoration stays hidden without re-emitting completion")
	tutorial.configure(0)
	for event in ["walked", "jump_landed", "investigated", "fork_completed"]: tutorial.observe(event)
	check(observed_steps == [3, 4, 1, 2, 3, 4], "All four exploration actions advance in order")
	if failures.is_empty(): print("ONBOARDING_ACCEPTANCE_PASS")
	else: push_error(str(failures))
	quit(0 if failures.is_empty() else 1)


