extends SceneTree
const FX = preload("res://scripts/world/time_authority_fx.gd")
const Stage = preload("res://scripts/world/combat_stage.gd")
const Actor = preload("res://scripts/world/combat_actor.gd")
func _initialize() -> void:
	_run.call_deferred()
func _run() -> void:
	var fx = FX.new()
	root.add_child(fx)
	fx.set_source(Vector2(235,416),217)
	assert(fx.radius == 150)
	fx.cast("enemy",Vector2(1030,430))
	fx.advance(.1)
	var start: Dictionary = fx.presentation_state()
	fx.advance(0)
	assert(start == fx.presentation_state())
	fx.advance(.1)
	var moving: Dictionary = fx.presentation_state()
	assert(start.streams[0].head != moving.streams[0].head)
	assert(moving.streams[0].tail_alpha[0] < moving.streams[0].tail_alpha[-1])
	fx.advance(.24)
	assert(fx.presentation_state().streams[0].arrived)
	assert(fx.presentation_state().streams[0].history_count < moving.streams[0].history_count)
	fx.advance(.4)
	assert(fx.beams.is_empty())
	var stage = Stage.new()
	root.add_child(stage)
	stage.configure("test",{"time_authority":true,"ambient_motion":true,"layers":[{"texture":"res://assets/chapter1/observatory_courtyard.png","size":[1440,900],"position":[720,450]}],"player":{"texture":"res://assets/moonli_battle_v1.png"}})
	stage.sync_snapshot({"hp":50,"enemies":[]})
	var pick: Rect2 = stage.get_target_rect("player")
	var before: Dictionary = stage.environment_motion.presentation_state()
	stage.advance(1,.2)
	assert(before != stage.environment_motion.presentation_state())
	var paused: Dictionary = stage.environment_motion.presentation_state()
	stage.advance(1,0)
	assert(paused == stage.environment_motion.presentation_state())
	stage.actors.player.play_animation("cast")
	stage.advance(.1,.1)
	assert(pick == stage.get_target_rect("player"))
	var actor = Actor.new()
	root.add_child(actor)
	var frames := SpriteFrames.new()
	frames.add_animation(&"idle")
	frames.set_animation_speed(&"idle", 8)
	for i in 4:
		frames.add_frame(&"idle", load("res://assets/moonli_battle_v1.png"))
	actor.configure("test", {"sprite_frames":frames},217,300)
	var stable: Rect2 = actor.get_target_rect()
	actor.advance(.14)
	assert(actor.animated_sprite.frame == 1)
	actor.sync({"hp":49})
	actor.play_animation("idle")
	assert(actor.animated_sprite.frame == 1)
	actor.advance(0)
	assert(actor.animated_sprite.frame == 1)
	actor.advance(.14)
	assert(actor.animated_sprite.frame == 2)
	assert(stable == actor.get_target_rect())
	await process_frame
	await process_frame
	if DisplayServer.get_name() != "headless":
		await RenderingServer.frame_post_draw
		root.get_texture().get_image().save_png("res://docs/verification/motion_world_render.png")
	print("MOTION_WORLD_ACCEPTANCE_PASS radius=150 path_heads=8 fading_trails=true pause_freeze=true battle_delta=true stable_collision=true")
	quit()

